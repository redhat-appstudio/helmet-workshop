# Copy to hack/workshop.env, customize, then:  set -a && source hack/workshop.env && set +a
#
# Used by container/build.sh and hack/setup-workshop.sh.

export WORKSHOP_IMAGE=quay.io/tsscdavp/helmet-workshop:dev
export PLATFORM=linux/amd64

export PARTICIPANT_COUNT=20
export INSTRUCTOR_COUNT=2

# Optional overrides (room code is auto-generated if unset):
# export WORKSHOP_CHALLENGE=my-custom-code
#
# Coordinator link (publish-coordinator-url.sh runs at end of setup):
# export WORKSHOP_PUBLISH_SHORT_URL=1
# export WORKSHOP_SHORTURL_SLUG=helmet-devconf   # base; indexed mode appends 1,2,3…
# export WORKSHOP_SHORTURL_INDEXED=1             # default when token+slug are set
# export WORKSHOP_SHORTURL_INDEX=2               # optional: pin slot (else auto from TinyURL GET)
# export TINYURL_API_TOKEN=...                 # tinyurl.com → Profile → API
#
# export COORDINATOR_IMAGE=quay.io/tsscdavp/helmet-workshop-coordinator:dev
# export RESTRICT_SELF_PROVISIONER=1
# export RHBK_ADMIN_USER=your-keycloak-admin-username
